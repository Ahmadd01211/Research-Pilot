# Local development only. Generate a unique value; do not commit .env.
POSTGRES_PASSWORD=replace-with-a-random-local-password
# Optional hosted evidence search. Source chunks leave your server when enabled.
RP_EMBEDDING_ENABLED=false
RP_ANSWER_ENABLED=false
RP_ANSWER_MODEL=gemini-3.8-flash
# Answer model is independently configurable. Check model access and billing before enabling.
RP_GOOGLE_API_KEY=
# Password-reset email. Defaults use the local Mailpit inbox at http://localhost:8025.
# For real delivery set your provider's host, port 587, RP_SMTP_SECURITY=starttls and credentials.
RP_SMTP_HOST=mail
RP_SMTP_PORT=1025
RP_SMTP_SECURITY=none
RP_SMTP_USERNAME=
RP_SMTP_PASSWORD=
