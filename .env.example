# Local development only. Generate a unique value; do not commit .env.
POSTGRES_PASSWORD=replace-with-a-random-local-password
# Development only: mount backend code live (API reloads, workers restart on save).
# Windows: compose.yaml;compose.dev.yaml   Linux/macOS: compose.yaml:compose.dev.yaml
# Leave commented out on servers.
# COMPOSE_FILE=compose.yaml;compose.dev.yaml

# Evidence search works without any provider: keyword (PostgreSQL full-text) search.
# Embeddings add semantic (hybrid) search.
#   local  - open-weights Qwen3-Embedding-0.6B in the embedder container. Free, no key,
#            paper text never leaves your server. Also set COMPOSE_PROFILES=local-embeddings.
#            Needs about 3 GB RAM; the first build downloads about 1.2 GB.
#   google - Gemini API with RP_GOOGLE_API_KEY. Source chunks are sent to Google.
RP_EMBEDDING_ENABLED=false
RP_EMBEDDING_PROVIDER=local
COMPOSE_PROFILES=
# CPU threads for local embeddings (match your server's cores).
RP_EMBEDDER_THREADS=4
RP_GOOGLE_API_KEY=

# Research Chat answers. The question and retrieved passages are sent to this provider.
RP_ANSWER_ENABLED=false
# google | openrouter
RP_ANSWER_PROVIDER=google
# Google: e.g. gemini-3.8-flash. OpenRouter: a model id such as vendor/model:free.
RP_ANSWER_MODEL=gemini-3.8-flash
RP_OPENROUTER_API_KEY=
# Shared across all users, enforced by the server per UTC day. Set it to your key's real quota.
RP_ANSWER_DAILY_LIMIT=20
# Per-researcher share of that budget. Empty = the whole budget (fine for one user).
# Set it lower (for example 5) before letting other researchers register.
RP_ANSWER_USER_DAILY_LIMIT=
# false (recommended for private papers): OpenRouter routes only to hosts that do not
# collect prompts; some free models then have no host. true allows hosts that may retain prompts.
RP_OPENROUTER_ALLOW_DATA_COLLECTION=false
