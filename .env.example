# Local development only. Generate a unique value; do not commit .env.
POSTGRES_PASSWORD=replace-with-a-random-local-password
# Optional hosted evidence search. Source chunks leave your server when enabled.
RP_EMBEDDING_ENABLED=false
RP_ANSWER_ENABLED=false
RP_ANSWER_MODEL=gemini-3.8-flash
# Answer model is independently configurable. Check model access and billing before enabling.
RP_GOOGLE_API_KEY=
