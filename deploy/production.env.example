# Production settings for docs/DEPLOYMENT.md. On the server: cp deploy/production.env.example .env
# Never commit the filled-in .env.

# Database password. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Public hostname pointing at the server, without https:// (for example researchpilot.duckdns.org)
RP_DOMAIN=
# Let's Encrypt contact for certificate expiry notices
RP_ACME_EMAIL=

# Password-reset email over encrypted SMTP. Gmail example: smtp.gmail.com, 587, starttls,
# your Gmail address and a 16-character app password (requires 2-Step Verification).
RP_SMTP_HOST=smtp.gmail.com
RP_SMTP_PORT=587
RP_SMTP_SECURITY=starttls
RP_SMTP_USERNAME=
RP_SMTP_PASSWORD=
# Gmail requires this to be the same address as RP_SMTP_USERNAME
RP_MAIL_FROM=ResearchPilot <you@gmail.com>

# Hosted AI stays off: enabling sends source text to Google and bills your key for every visitor.
RP_EMBEDDING_ENABLED=false
RP_ANSWER_ENABLED=false
RP_GOOGLE_API_KEY=
